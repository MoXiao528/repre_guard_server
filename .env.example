# Generate once, then use the same value in AIDetector-Back/.env.
REPRE_GUARD_SERVICE_TOKEN=
REPRE_GUARD_MAX_PENDING_REQUESTS=3
REPRE_GUARD_QUEUE_TIMEOUT_SECONDS=15

# Optional internal /evidence/route endpoint; disabled until deployment acceptance.
REPRE_GUARD_EVIDENCE_ENABLED=false
# Point to the immutable production-final/model directory containing exactly six files.
REPRE_GUARD_EVIDENCE_MODEL_PATH=
REPRE_GUARD_EVIDENCE_ARTIFACT_SHA256=
# Response deadline in seconds, finite and >0 through 60; timed-out work retains its slot.
REPRE_GUARD_EVIDENCE_TIMEOUT_SECONDS=10

# Linux deployments must replace the Windows model-path defaults with real absolute paths.
# REPRE_GUARD_MODEL_CACHE_DIR=/srv/aidetector/models/cache
# REPRE_GUARD_MODEL_PATH=/srv/aidetector/models/DetectRL-X-XLM-RoBERTa-Detector-All
